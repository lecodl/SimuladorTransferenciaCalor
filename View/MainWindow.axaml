<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimuladorTransferenciaCalor.View.MainWindow"
        Width="1000"
        Height="700"
        Title="Simulador de Transferência de Calor"
        Background="#F3F6FB">

    <Grid Margin="20"
            RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="#FFFFFF"
                Padding="16"
                BorderBrush="#D9E2F1"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Left">

                                <StackPanel>
                                        <TextBlock Text="Linhas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4A5A6A" />
                                        <TextBox x:Name="LinhasInput"
                                                         Width="90"
                                                         Text="4"
                                                         Watermark="10" />
                                </StackPanel>

                                <StackPanel>
                                        <TextBlock Text="Colunas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4A5A6A" />
                                        <TextBox x:Name="ColunasInput"
                                                         Width="90"
                                                         Text="4"
                                                         Watermark="10" />
                                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Material"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#4A5A6A" />
                    <ComboBox x:Name="MaterialInput"
                              Width="180"
                              SelectedIndex="0"
                                                          Background="#F8FAFF">
                                                <ComboBoxItem Content="Cobre" />
                                                <ComboBoxItem Content="Alumínio" />
                                                <ComboBoxItem Content="Ferro" />
                                                <ComboBoxItem Content="Aço" />
                                                <ComboBoxItem Content="Vidro" />
                                                <ComboBoxItem Content="Madeira" />
                                                <ComboBoxItem Content="Água" />
                                                <ComboBoxItem Content="Concreto" />
                                        </ComboBox>
                </StackPanel>

                <Button x:Name="GerarMatrizButton"
                        Content="Gerar matriz"
                        Width="140"
                        Height="36"
                        Background="#2F6FED"
                        Foreground="White"
                        Click="GerarMatrizButton_Click" />

                <Button x:Name="ExecutarPassoButton"
                        Content="Executar passo"
                        Width="140"
                        Height="36"
                        Background="#3B82F6"
                        Foreground="White"
                        Click="ExecutarPassoButton_Click" />

                <Button x:Name="IniciarButton"
                        Content="Iniciar"
                        Width="110"
                        Height="36"
                        Background="#16A34A"
                        Foreground="White"
                        Click="IniciarButton_Click" />

                <Button x:Name="PararButton"
                        Content="Parar"
                        Width="110"
                        Height="36"
                        Background="#DC2626"
                        Foreground="White"
                        Click="PararButton_Click" />

            </StackPanel>
        </Border>

        <TextBlock x:Name="TempoText"
                   Grid.Row="1"
                   Text="00:00:00"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#243B53" />

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="18"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#D9E2F1"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="MatrizVisual"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

    </Grid>

</Window>